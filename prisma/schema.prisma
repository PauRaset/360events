// Prisma schema · 360Events.cat
// Capa de dades: artistes i reserves.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artista {
  id          String   @id @default(cuid())
  slug        String   @unique
  nom         String
  categoria   String
  descripcio  String   @db.Text
  riderTecnic String?  @db.Text
  fotos       String[]
  videos      String[]
  destacat    Boolean  @default(false)
  actiu       Boolean  @default(true)
  createdAt   DateTime @default(now())

  reserves        Reserva[]
  usuari          Usuari?
  disponibilitat  Disponibilitat[]
  pressupostos    Pressupost[]
}

enum RolUsuari {
  ADMIN
  ARTISTA
}

model Usuari {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  rol          RolUsuari @default(ARTISTA)
  artistaId    String?   @unique
  artista      Artista?  @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

enum EstatDia {
  OCUPAT
  RESERVAT
}

model Disponibilitat {
  id        String   @id @default(cuid())
  artistaId String
  artista   Artista  @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  data      DateTime @db.Date
  estat     EstatDia @default(OCUPAT)
  nota      String?
  createdAt DateTime @default(now())

  @@unique([artistaId, data])
}

enum EstatReserva {
  NOVA
  EN_REVISIO
  PRESSUPOST_ENVIAT
  CONFIRMADA
  CANCELLADA
}

model Reserva {
  id          String       @id @default(cuid())
  nom         String
  telefon     String
  email       String
  tipusEvent  String
  dataEvent   DateTime
  ubicacio    String
  assistents  Int?
  missatge    String?      @db.Text
  artistaId   String?
  artista     Artista?     @relation(fields: [artistaId], references: [id])
  servei      String?
  estat       EstatReserva @default(NOVA)
  gcalEventId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  pressupostos Pressupost[]
}

enum EstatPressupost {
  ESBORRANY
  ENVIAT
  SIGNAT
  REBUTJAT
  CANCELLAT
}

model Pressupost {
  id            String          @id @default(cuid())
  codi          String          @unique
  token         String          @unique
  estat         EstatPressupost @default(ESBORRANY)

  artistaId     String?
  artista       Artista?        @relation(fields: [artistaId], references: [id])
  reservaId     String?
  reserva       Reserva?        @relation(fields: [reservaId], references: [id])

  clientNom     String
  clientEmail   String
  clientTelefon String?

  tipusEvent    String?
  dataEvent     DateTime        @db.Date
  horaInici     String?
  ubicacio      String?

  concepte      String          @db.Text
  condicions    String?         @db.Text
  importCentims Int

  signatNom       String?
  signatDni       String?
  signatData      DateTime?
  signatIp        String?
  signatUserAgent String?
  signatHash      String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equip {
  id         String   @id @default(cuid())
  nom        String
  categoria  String
  descripcio String?  @db.Text
  fotos      String[]
  destacat   Boolean  @default(false)
  actiu      Boolean  @default(true)
  ordre      Int      @default(0)
  createdAt  DateTime @default(now())
}
